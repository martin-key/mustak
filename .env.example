# Копирайте този файл като .env и попълнете стойностите:
#   cp .env.example .env
# Случайни стойности се генерират с:  openssl rand -hex 32
# Файлът .env никога не се commit-ва.

# --- База данни ------------------------------------------------------------
# Използват се от docker-compose.yml (контейнерът на Postgres и адресът на приложението).
POSTGRES_USER=mustak
POSTGRES_DB=mustak
# Само букви и цифри (напр. openssl rand -hex 24), за да не се налага URL кодиране.
POSTGRES_PASSWORD=

# Адрес за локална разработка (npm run dev) срещу базата от docker-compose.dev.yml.
# В docker compose приложението получава собствен адрес към контейнера "db".
DATABASE_URL=postgres://mustak:СМЕНЕТЕ-С-POSTGRES_PASSWORD@localhost:5433/mustak

# --- Приложение -------------------------------------------------------------
# Публичният адрес на сайта. Използва се за линковете за отказ в отговорите на API-то.
# При https бисквитката на админ сесията получава флаг Secure.
APP_URL=http://localhost:3000
# Порт на хоста за docker compose.
APP_PORT=3000

# --- Docker образ (docker compose) ------------------------------------------
# Образът на приложението. По подразбиране е публикуваният в GitHub Container Registry.
# Във fork: ghcr.io/<вашият-акаунт>/<repo>.
APP_IMAGE=ghcr.io/martin-key/mustak
# Таг: latest (последният commit в main), версия (напр. 1.4.0) или sha-<commit> (за връщане назад).
APP_IMAGE_TAG=latest

# --- Първи администратор ----------------------------------------------------
# Създава се при първото зареждане на данни, само ако в базата още няма администратор.
# Паролата трябва да е поне 12 символа. След първия вход можете да я махнете оттук.
ADMIN_EMAIL=admin@mustak.example
ADMIN_PASSWORD=
ADMIN_NAME=Собственик

# --- API за AI агента -------------------------------------------------------
# Таен ключ (поне 32 символа) за хедъра X-API-Key. Ако е празен, API-то е изключено.
AGENT_API_KEY=

# --- Защита от ботове: Cloudflare Turnstile (по желание) --------------------
# Проверката „Не съм робот“ на последната стъпка от записването. Без ключове е изключена
# и сайтът не зарежда нищо от Cloudflare.
# Ключове: Cloudflare табло → Turnstile → Add widget (режим Managed, домейнът на сайта).
# За локален тест: публичните тестови ключове на Cloudflare (винаги минават):
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Адресите на сайта, от които се приема проверката, през запетая (напр. mustak.bg,www.mustak.bg).
# По подразбиране: адресът от APP_URL. В продукция не слагайте localhost.
TURNSTILE_HOSTNAMES=

# --- Чат асистент в n8n (по желание) -----------------------------------------
# Балончето долу вдясно на сайта. Без адреса балончето не се показва.
# Как се пуска workflow-ът в n8n: docs/n8n-chat-agent.md
# Production URL на възела „Чат съобщение“ (Chat Trigger) в n8n.
N8N_CHAT_WEBHOOK_URL=
# Basic Auth на Chat Trigger-а (същите като в credential-а „Мустак чат (Basic Auth)“ в n8n).
N8N_CHAT_USERNAME=
N8N_CHAT_PASSWORD=

# --- Примерни данни -----------------------------------------------------------
# true: при празна база се зареждат примерни услуги, бръснари, работно време и часове.
SEED_DEMO_DATA=true

# Изключва анонимната телеметрия на Next.js.
NEXT_TELEMETRY_DISABLED=1
